NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-your-publishable-or-anon-key
NEXT_PUBLIC_KOKO_BACKEND_URL=http://localhost:5001
FREEREADER_TTS_API_TOKEN=replace-with-the-server-only-freereader-tts-token
# Qwen3-TTS voice cloning. Server-only: never expose the Modal proxy credentials
# with a NEXT_PUBLIC prefix, and set these in the Vercel project for previews.
MODAL_QWEN3_TTS_URL=https://your-workspace--freereader-qwen3-tts-qwen3ttsserver-web.modal.run
MODAL_QWEN3_TTS_PROXY_TOKEN=replace-with-the-workspace-modal-proxy-token
MODAL_QWEN3_TTS_PROXY_SECRET=replace-with-the-workspace-modal-proxy-secret
