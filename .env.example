NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-your-publishable-or-anon-key
NEXT_PUBLIC_KOKO_BACKEND_URL=http://localhost:5001
FREEREADER_TTS_API_TOKEN=replace-with-the-server-only-freereader-tts-token

# EDU is opt-in; branch-scoped Preview configuration enables it for testing.
EDU_ENABLED=false
EDU_HOST=edu.freereader.io
NEXT_PUBLIC_EDU_HOST=edu.freereader.io
# Password required to open any EDU route. When unset, EDU is fully locked.
EDU_ACCESS_PASSWORD=
